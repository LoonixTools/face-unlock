[Unit]
Description=Face unlock for KDE Plasma (lock screen and bubble)
Documentation=man:face-unlock(1)
PartOf=graphical-session.target
After=graphical-session.target
# Plasma on Wayland. The bubble is a layer-shell surface, and there is no such
# thing on X11.
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
ExecStart=@LIBEXECDIR@/face-unlock-agent
Restart=on-failure
RestartSec=3
Slice=session.slice

[Install]
WantedBy=graphical-session.target
