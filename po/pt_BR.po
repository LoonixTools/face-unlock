msgid "Settings"
msgstr "Configurações"

#: src/lib/menu.sh:495
msgid "↑↓ select   ←→ or Space: change   q: back"
msgstr "↑↓ escolher   ←→ ou Espaço: mudar   q: voltar"

#: src/lib/menu.sh:496
msgid "for all users, asks for your password"
msgstr "para todos os usuários, pede a sua senha"

#. TRANSLATORS: keep the letters, they are the keys.
#: src/lib/menu.sh:592
msgid "Up/Down: select, Space: on/off, r: rename, d: delete, a: add, q: back"
msgstr "Cima/Baixo: escolher, Espaço: ativar/desativar, r: renomear, d: apagar, a: adicionar, q: voltar"

#: src/lib/menu.sh:593
msgid "No face is set up yet. Press a to add one."
msgstr "Nenhum rosto configurado ainda. Aperte a para adicionar um."

#: src/lib/menu.sh:639
msgid "New name:"
msgstr "Novo nome:"

#: src/lib/menu.sh:646
#, sh-printf-format
msgid "Delete \"%s\"?"
msgstr "Apagar \"%s\"?"

#: src/lib/menu.sh:677
msgid "Turn face unlock on or off"
msgstr "Ativar ou desativar o desbloqueio facial"

#: src/lib/menu.sh:681
msgid "Try it"
msgstr "Testar"

#: src/lib/menu.sh:682
msgid "Quit"
msgstr "Sair"

