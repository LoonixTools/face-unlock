msgstr "Também para sudo e pedidos de administrador"

#: src/agent/bubblecontroller.cpp:98
msgid "Blink once"
msgstr "Pisque uma vez"

#: src/agent/bubblecontroller.cpp:100
msgid "Look at the screen"
msgstr "Olhe para a tela"

#: src/agent/bubblecontroller.cpp:102
msgid "Move closer"
msgstr "Chegue mais perto"

#: src/agent/bubblecontroller.cpp:104
msgid "Too dark"
msgstr "Escuro demais"

#: src/agent/bubblecontroller.cpp:124
msgid "Use your password"
msgstr "Use a sua senha"

#: src/agent/bubblecontroller.cpp:130
msgid "Not recognized"
msgstr "Não reconhecido"

#: src/agent/bubblecontroller.cpp:132
msgid "Try again and blink"
msgstr "Tente de novo e pisque"

#: src/agent/bubblecontroller.cpp:134
msgid "Camera unavailable"
msgstr "Câmera indisponível"

#: src/agent/enrollcontroller.cpp:68
msgid "Bring your face into the circle."
msgstr "Coloque o rosto dentro do círculo."

#: src/agent/enrollcontroller.cpp:70
msgid "Only one face, please."
msgstr "Apenas um rosto, por favor."

#: src/agent/enrollcontroller.cpp:72
msgid "Move a little closer."
msgstr "Chegue um pouco mais perto."

#: src/agent/enrollcontroller.cpp:74
msgid "It is too dark. Turn on a light."
msgstr "Está escuro demais. Acenda uma luz."

#: src/agent/enrollcontroller.cpp:76
msgid "Too bright. Turn away from the light."
msgstr "Claro demais. Vire-se de costas para a luz."

#: src/agent/enrollcontroller.cpp:78
msgid "Hold still for a moment."
msgstr "Fique parado por um momento."

#: src/agent/enrollcontroller.cpp:80
msgid "Look straight at the camera."
msgstr "Olhe direto para a câmera."

#: src/agent/enrollcontroller.cpp:82
msgid "Move your head slowly to complete the circle."
msgstr "Mova a cabeça devagar para completar o círculo."

#: src/agent/enrollcontroller.cpp:99 src/agent/enrollcontroller.cpp:132
msgid "Starting the camera…"
msgstr "Iniciando a câmera…"

#: src/agent/enrollcontroller.cpp:129
msgid "Confirm with your password to add a face."
msgstr "Confirme com a sua senha para adicionar um rosto."

#: src/agent/enrollcontroller.cpp:184
msgid "Face Unlock is set up."
msgstr "O desbloqueio facial está configurado."

#: src/agent/enrollcontroller.cpp:193
msgid "A face can only be added with your password."
msgstr "Um rosto só pode ser adicionado com a sua senha."

#: src/agent/enrollcontroller.cpp:195
msgid "The camera could not be used: %1"
msgstr "Não foi possível usar a câmera: %1"

#: src/agent/enrollcontroller.cpp:197
msgid "The face recognition models are missing. Reinstall the package."
msgstr "Os modelos de reconhecimento facial estão faltando. Reinstale o pacote."

#: src/agent/enrollcontroller.cpp:199
msgid "That took too long. Try again, in good light."
msgstr "Demorou demais. Tente de novo, com boa luz."

