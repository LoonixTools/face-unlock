#: src/system.rs:131
msgid ""
"Hyprland does not start the lock screen agent by itself. Add this to %s:"
msgstr "Hyprland сам не запускає агент екрана блокування. Додайте це до %s:"

#: src/system.rs:133
msgid "Hyprland does not start the polkit agent by itself. Add this to %s:"
msgstr "Hyprland сам не запускає агент polkit. Додайте це до %s:"

#: src/system.rs:216
msgid "No package manager found to install a polkit agent with."
msgstr "Не знайдено менеджера пакетів, щоб встановити агент polkit."

#: src/system.rs:218
msgid "Could not install a polkit agent."
msgstr "Не вдалося встановити агент polkit."

#: src/system.rs:244
msgid "The polkit agent did not start. See: systemctl --user status %s"
msgstr "Агент polkit не запустився. Дивіться: systemctl --user status %s"

#: src/system.rs:407
