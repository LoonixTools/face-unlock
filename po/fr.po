#: gui/src/setup.rs:63
msgid "Bring your face into the circle."
msgstr "Placez votre visage dans le cercle."

#: gui/src/setup.rs:64
msgid "Only one face, please."
msgstr "Un seul visage, s'il vous plaît."

#: gui/src/setup.rs:65
msgid "Move a little closer."
msgstr "Rapprochez-vous un peu."

#: gui/src/setup.rs:66
msgid "It is too dark. Turn on a light."
msgstr "Il fait trop sombre. Allumez une lumière."

#: gui/src/setup.rs:67
msgid "Too bright. Turn away from the light."
msgstr "Trop lumineux. Détournez-vous de la lumière."

