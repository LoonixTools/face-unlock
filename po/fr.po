#: src/agent/enrollcontroller.cpp:76
msgid "Too bright. Turn away from the light."
msgstr "Trop lumineux. Détournez-vous de la lumière."

#: src/agent/enrollcontroller.cpp:78
msgid "Hold still for a moment."
msgstr "Ne bougez plus un instant."

#: src/agent/enrollcontroller.cpp:80
msgid "Look straight at the camera."
msgstr "Regardez droit dans la caméra."

#: src/agent/enrollcontroller.cpp:82
msgid "Move your head slowly to complete the circle."
