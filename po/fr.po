msgstr "Configurer votre visage"

#: gui/src/setup.rs:399
msgid "Confirm it is you"
msgstr "Confirmez que c'est vous"

#: gui/src/setup.rs:401
msgid "Setup did not finish"
msgstr "La configuration n'est pas terminée"

