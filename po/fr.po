msgstr "sudo dans un terminal"

#: src/lib/menu.sh
msgid "Recognition"
msgstr "Reconnaissance"

#: src/lib/menu.sh
msgid "How closely the face has to match"
msgstr "Précision de la correspondance"

#: src/lib/menu.sh
msgid "Only when you look at the screen"
msgstr "Seulement quand vous regardez l'écran"

#: src/lib/menu.sh
msgid "How long a scan lasts"
msgstr "Durée d'un scan"

#: src/lib/menu.sh
msgid "Learn from every unlock"
msgstr "Apprendre à chaque déverrouillage"

#: src/lib/menu.sh
msgid "Not when the lid is closed"
msgstr "Pas quand le portable est fermé"

#: src/lib/menu.sh
msgid "Bubble"
msgstr "Bulle"

#: src/lib/menu.sh
msgid "Show the bubble"
msgstr "Afficher la bulle"

#: src/lib/menu.sh
msgid "Style"
msgstr "Style"

#: src/lib/menu.sh
msgid "Animation speed"
msgstr "Vitesse d'animation"

#: src/lib/menu.sh
msgid "Also for sudo and admin prompts"
msgstr "Aussi pour sudo et les demandes admin"

#: src/agent/bubblecontroller.cpp:98
msgid "Blink once"
msgstr "Clignez une fois"

#: src/agent/bubblecontroller.cpp:100
msgid "Look at the screen"
msgstr "Regardez l'écran"

#: src/agent/bubblecontroller.cpp:102
msgid "Move closer"
msgstr "Rapprochez-vous"

#: src/agent/bubblecontroller.cpp:104
msgid "Too dark"
msgstr "Trop sombre"

#: src/agent/bubblecontroller.cpp:124
msgid "Use your password"
msgstr "Utilisez votre mot de passe"

#: src/agent/bubblecontroller.cpp:130
msgid "Not recognized"
msgstr "Non reconnu"

#: src/agent/bubblecontroller.cpp:132
msgid "Try again and blink"
msgstr "Réessayez et clignez"

#: src/agent/bubblecontroller.cpp:134
msgid "Camera unavailable"
msgstr "Caméra indisponible"

#: src/agent/enrollcontroller.cpp:68
msgid "Bring your face into the circle."
msgstr "Placez votre visage dans le cercle."

#: src/agent/enrollcontroller.cpp:70
msgid "Only one face, please."
msgstr "Un seul visage, s'il vous plaît."

#: src/agent/enrollcontroller.cpp:72
