msgstr "Yeux ouverts"

#: gui/src/trial.rs:176
msgid "Closed eyes do not unlock."
msgstr "Des yeux fermés ne déverrouillent pas."

#: gui/src/trial.rs:177
msgid "Depth"
msgstr "Profondeur"

#: gui/src/trial.rs:177
msgid "A head that turns shows its nose sticking out. A photo cannot."
msgstr ""
"Une tête qui tourne montre son nez qui dépasse. Une photo ne le peut pas."

#: gui/src/trial.rs:178
msgid "Blink"
msgstr "Clignement"

#: gui/src/trial.rs:178
msgid "A blink is a sign of life too."
msgstr "Un clignement est aussi un signe de vie."

#: gui/src/trial.rs:179
msgid "Glare"
msgstr "Reflet"

