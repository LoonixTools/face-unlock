msgstr "normal"

#: src/lib/menu.sh:195
msgid "relaxed"
msgstr "souple"

#: src/lib/menu.sh:196
msgid "island with the face"
msgstr "îlot avec le visage"

#: src/lib/menu.sh:197
msgid "small pill with a lock"
msgstr "petite pilule à cadenas"

#: src/lib/menu.sh:199
msgid "fast"
msgstr "rapide"

#: src/lib/menu.sh:200
msgid "slow"
msgstr "lent"

#: src/lib/menu.sh:201
#, sh-printf-format
