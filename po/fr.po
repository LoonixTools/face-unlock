#: src/face-unlock:50
msgid ""
"Face unlock's service has to be switched on once for this computer. That "
"needs your password."
msgstr ""
"Le service de déverrouillage facial doit être activé une fois sur cet "
"ordinateur. Cela demande votre mot de passe."

#: src/face-unlock:57
#, sh-printf-format
msgid "Check it with: systemctl status %s"
msgstr "Vérifiez avec : systemctl status %s"

#: src/face-unlock:67
msgid ""
"Setting up a face needs the camera picture on screen. Run this inside your "
"desktop session."
msgstr ""
"Pour configurer un visage, l'image de la caméra doit s'afficher à l'écran. "
"Lancez ceci dans votre session de bureau."

#: src/face-unlock:71
msgid "The setup window is open. Follow it there."
msgstr ""
"La fenêtre de configuration est ouverte. Suivez les étapes qui s'y trouvent."

#: src/face-unlock:80
msgid "The face is set up."
msgstr "Le visage est configuré."

#: src/face-unlock:83
#, sh-printf-format
msgid "Face unlock is still off. Turn it on with [1] or `%s enable`."
msgstr ""
"Le déverrouillage facial est encore désactivé. Activez-le avec [1] ou `%s "
"enable`."

#: src/face-unlock:87
msgid "No face was added."
msgstr "Aucun visage n'a été ajouté."

#: src/face-unlock:96
msgid "First, set up your face."
msgstr "Configurez d'abord votre visage."

#: src/face-unlock:100 src/face-unlock:145 src/lib/menu.sh:517
#: src/lib/menu.sh:521 src/lib/menu.sh:527 src/lib/menu.sh:529
#: src/lib/system.sh:290 src/lib/system.sh:296
msgid "Could not save the setting."
msgstr "Impossible d'enregistrer le réglage."

#: src/face-unlock:104
msgid "Could not start the lock screen agent."
msgstr "Impossible de démarrer l'agent de l'écran de verrouillage."

#: src/face-unlock:107
msgid "No systemd user session, so the lock screen agent was not started."
msgstr ""
"Pas de session utilisateur systemd, l'agent de l'écran de verrouillage n'a "
"donc pas été démarré."

#: src/face-unlock:123
msgid "Could not switch on the GNOME extension that shows the bubble."
msgstr "Impossible d'activer l'extension GNOME qui affiche la bulle."

#: src/face-unlock:124
msgid "Log out and back in once: then GNOME shows the bubble too."
msgstr ""
"Déconnectez-vous puis reconnectez-vous une fois : GNOME affichera alors "
"aussi la bulle."

#: src/face-unlock:131
msgid "Pick your lock screen in the window."
msgstr "Choisissez votre écran de verrouillage dans la fenêtre."

#: src/face-unlock:132
msgid "No lock screen picked. You can do it later under Settings."
msgstr ""
"Aucun écran de verrouillage choisi. Vous pouvez le faire plus tard dans "
"Réglages."

#: src/face-unlock:135
#, sh-printf-format
msgid ""
"The lock screen (%s) takes your face too. If it does not scan when you come "
"back, press Enter on the empty password field."
msgstr ""
"L'écran de verrouillage (%s) accepte aussi votre visage. S'il ne scanne pas "
"à votre retour, appuyez sur Entrée dans le champ du mot de passe vide."

#: src/face-unlock:138
msgid "Face unlock is on. Lock the screen and look at it to try."
msgstr ""
"Le déverrouillage facial est activé. Verrouillez l'écran et regardez-le pour "
"essayer."

#: src/face-unlock:140
msgid "It can do sudo and admin prompts too. See Settings."
msgstr ""
"Il fonctionne aussi pour sudo et les demandes d'administration. Voir "
"Réglages."

#: src/face-unlock:156
msgid "Face unlock is off. Your faces are kept; delete them under Faces."
msgstr ""
"Le déverrouillage facial est désactivé. Vos visages sont conservés ; "
"supprimez-les dans Visages."

#: src/face-unlock:170 src/lib/daemon.sh:109
msgid "No face is set up yet."
msgstr "Aucun visage n'est encore configuré."

#: src/face-unlock:174 src/lib/menu.sh:180 src/lib/menu.sh:685
msgid "on"
msgstr "activé"

#: src/face-unlock:174 src/lib/menu.sh:182 src/lib/menu.sh:192
#: src/lib/menu.sh:686
msgid "off"
msgstr "désactivé"

#: src/face-unlock:176 src/lib/menu.sh:703
#, sh-printf-format
msgid "%s samples, %s learned"
msgstr "%s échantillons, %s appris"

#: src/face-unlock:182
#, sh-printf-format
msgid "Which face? See `%s faces` for the ids."
msgstr "Quel visage ? Voir `%s faces` pour les identifiants."

#: src/face-unlock:186
msgid "Deleted."
msgstr "Supprimé."

#: src/face-unlock:197
msgid "Usage: face-unlock [command]"
msgstr "Utilisation : face-unlock [commande]"

#: src/face-unlock:199
msgid "Commands:"
msgstr "Commandes :"

#: src/face-unlock:200
msgid "Turn face unlock on"
msgstr "Activer le déverrouillage facial"

#: src/face-unlock:201
msgid "Turn it off (faces are kept)"
msgstr "Le désactiver (les visages sont conservés)"

#: src/face-unlock:202 src/lib/menu.sh:769
msgid "Add a face"
msgstr "Ajouter un visage"

#: src/face-unlock:203
msgid "List the faces"
msgstr "Lister les visages"

#: src/face-unlock:204
msgid "Delete a face"
msgstr "Supprimer un visage"

#: src/face-unlock:205
msgid "Look at the camera and see what it sees"
msgstr "Regarder la caméra et voir ce qu'elle voit"

#: src/face-unlock:206
msgid "Lock the screen"
msgstr "Verrouiller l'écran"

#: src/face-unlock:207
msgid "Show what is on"
msgstr "Afficher ce qui est activé"

#: src/face-unlock:208
msgid "Show this help"
msgstr "Afficher cette aide"

#: src/face-unlock:209
msgid "Show the version"
msgstr "Afficher la version"

#: src/face-unlock:211
msgid "Without a command an interactive menu is shown."
msgstr "Sans commande, un menu interactif s'affiche."

#: src/face-unlock:230
msgid ""
"Run this as your own user, not as root. It asks for your password when it "
"needs to."
msgstr ""
"Lancez ceci avec votre propre utilisateur, pas en root. Le mot de passe est "
"demandé quand il le faut."

#: src/face-unlock:253 src/lib/system.sh:101
#, sh-printf-format
msgid "Unknown command: %s"
msgstr "Commande inconnue : %s"

#: src/lib/common.sh:173
msgid "never"
msgstr "jamais"

#: src/lib/common.sh:183
msgid "just now"
msgstr "à l'instant"

#: src/lib/common.sh:185
msgid "1 minute ago"
msgstr "il y a 1 minute"

#: src/lib/common.sh:188
#, sh-printf-format
msgid "%d minutes ago"
msgstr "il y a %d minutes"

#: src/lib/common.sh:190
msgid "1 hour ago"
msgstr "il y a 1 heure"

#: src/lib/common.sh:193
#, sh-printf-format
msgid "%d hours ago"
msgstr "il y a %d heures"

#: src/lib/common.sh:195
msgid "1 day ago"
msgstr "il y a 1 jour"

#: src/lib/common.sh:198
#, sh-printf-format
msgid "%d days ago"
msgstr "il y a %d jours"

#: src/lib/daemon.sh:102
msgid "The face did not match."
msgstr "Le visage ne correspondait pas."

#: src/lib/daemon.sh:103
msgid "That looked like a photo or a screen."
msgstr "Cela ressemblait à une photo ou à un écran."

#: src/lib/daemon.sh:104
msgid "The face matched, but did not blink or move."
msgstr "Le visage correspondait, mais n'a ni cligné des yeux ni bougé."

#: src/lib/daemon.sh:105
msgid "The face was not looking at the screen."
msgstr "Le visage ne regardait pas l'écran."

#: src/lib/daemon.sh:106
msgid "The picture was too dark, too blurry or too far away."
msgstr "L'image était trop sombre, trop floue ou trop lointaine."

#: src/lib/daemon.sh:107
msgid "No face in view."
msgstr "Aucun visage visible."

#: src/lib/daemon.sh:108
msgid ""
"Face unlock is paused after too many tries. Unlock once with your password."
msgstr ""
"Le déverrouillage facial est en pause après trop d'essais. Déverrouillez une "
"fois avec votre mot de passe."

#: src/lib/daemon.sh:110
msgid "The camera could not be used."
msgstr "La caméra n'a pas pu être utilisée."

#: src/lib/daemon.sh:111 src/lib/menu.sh:267
msgid "The recognition models are missing. Reinstall the package."
msgstr "Les modèles de reconnaissance sont absents. Réinstallez le paquet."

#: src/lib/daemon.sh:112
msgid "The lid is closed."
msgstr "L'ordinateur portable est fermé."

#: src/lib/daemon.sh:113
msgid "The camera is busy with another scan."
msgstr "La caméra est occupée par un autre scan."

#: src/lib/daemon.sh:114
msgid "The face unlock service is not running."
msgstr "Le service de déverrouillage facial n'est pas lancé."

#: src/lib/daemon.sh:115
msgid "Not allowed."
msgstr "Non autorisé."

#: src/lib/daemon.sh:116
#, sh-printf-format
msgid "Something went wrong (%s)."
msgstr "Une erreur s'est produite (%s)."

#: src/lib/daemon.sh:127
msgid "Look at the camera. Blink once, or turn your head a little."
msgstr ""
"Regardez la caméra. Clignez des yeux une fois ou tournez un peu la tête."

#: src/lib/daemon.sh:137
msgid "Face found."
msgstr "Visage trouvé."

#: src/lib/daemon.sh:141
msgid "Recognised. Now blink once, or turn your head a little."
msgstr ""
"Reconnu. Clignez maintenant des yeux une fois ou tournez un peu la tête."

#: src/lib/daemon.sh:142
msgid "Look at the screen."
msgstr "Regardez l'écran."

#: src/lib/daemon.sh:143
msgid "Move closer to the camera."
msgstr "Rapprochez-vous de la caméra."

#: src/lib/daemon.sh:144
msgid "It is too dark to see your face."
msgstr "Il fait trop sombre pour voir votre visage."

#: src/lib/daemon.sh:153
msgid "match"
msgstr "score"

#: src/lib/daemon.sh:153
msgid "turn"
msgstr "rotation"

#: src/lib/daemon.sh:154
msgid "eyes"
msgstr "yeux"

#: src/lib/daemon.sh:155
msgid "depth"
msgstr "profondeur"

#: src/lib/daemon.sh:155 src/lib/daemon.sh:164
msgid "blink"
msgstr "clignement"

#: src/lib/daemon.sh:156
msgid "glare"
msgstr "reflet"

#: src/lib/daemon.sh:156
msgid "edge"
msgstr "bord"

#: src/lib/daemon.sh:165
msgid "head turn"
msgstr "rotation de la tête"

#: src/lib/daemon.sh:167
#, sh-printf-format
msgid "Recognised as %s (match %s) in %s ms."
msgstr "Reconnu comme %s (score %s) en %s ms."

#: src/lib/daemon.sh:168
#, sh-printf-format
msgid "Sign of life: %s"
msgstr "Signe de vie : %s"

#: src/lib/daemon.sh:173
msgid ""
"That was too many tries. Face unlock is paused until you unlock with your "
"password."
msgstr ""
"Trop d'essais. Le déverrouillage facial est en pause jusqu'à ce que vous "
"déverrouilliez avec votre mot de passe."

#. TRANSLATORS: the letter after "[" is the key for yes. y works too.
#: src/lib/menu.sh:141
msgid "[y/N]"
msgstr "[o/N]"

#: src/lib/menu.sh:172 src/lib/menu.sh:583
msgid "ON"
msgstr "ACTIVÉ"

#: src/lib/menu.sh:174 src/lib/menu.sh:584
msgid "OFF"
msgstr "DÉSACTIVÉ"

#: src/lib/menu.sh:190 src/lib/menu.sh:194
msgid "strict"
msgstr "strict"

#: src/lib/menu.sh:191
msgid "basic"
msgstr "basique"

#: src/lib/menu.sh:193 src/lib/menu.sh:198
msgid "normal"
msgstr "normal"

#: src/lib/menu.sh:195
msgid "relaxed"
msgstr "souple"

#: src/lib/menu.sh:196
msgid "island with the face"
msgstr "îlot avec le visage"

#: src/lib/menu.sh:197
msgid "small pill with a lock"
msgstr "petite pilule à cadenas"

#: src/lib/menu.sh:199
msgid "fast"
msgstr "rapide"

#: src/lib/menu.sh:200
msgid "slow"
msgstr "lent"

#: src/lib/menu.sh:201
#, sh-printf-format
msgid "%s seconds"
msgstr "%s secondes"

#: src/lib/menu.sh:202 src/lib/menu.sh:452
msgid "automatic"
msgstr "automatique"

#: src/lib/menu.sh:203
msgid "face-unlock's"
msgstr "celui de face-unlock"

#: src/lib/menu.sh:204
msgid "yours"
msgstr "le vôtre"

#: src/lib/menu.sh:221
msgid "Face unlock"
msgstr "Déverrouillage facial"

#: src/lib/menu.sh:225
msgid "Service"
msgstr "Service"

#: src/lib/menu.sh:225
msgid "not running"
msgstr "arrêté"

#: src/lib/menu.sh:227
msgid "Turning face unlock on again starts it."
msgstr "Réactiver le déverrouillage facial le démarre."

#: src/lib/menu.sh:238 src/lib/menu.sh:240 src/lib/menu.sh:681
#: src/lib/menu.sh:770
msgid "Faces"
msgstr "Visages"

#: src/lib/menu.sh:238
msgid "none set up yet"
msgstr "aucun configuré pour l'instant"

#: src/lib/menu.sh:240
msgid "all turned off"
msgstr "tous désactivés"

#: src/lib/menu.sh:246
msgid "none found"
msgstr "aucune trouvée"

#: src/lib/menu.sh:248 src/lib/menu.sh
msgid "Camera"
msgstr "Caméra"

#: src/lib/menu.sh:250 src/lib/menu.sh
msgid "Lock screen"
msgstr "Écran de verrouillage"

#: src/lib/menu.sh:254
msgid "sudo"
msgstr "sudo"

#: src/lib/menu.sh:255 src/lib/menu.sh
msgid "Admin prompts"
msgstr "Demandes d'administration"

#: src/lib/menu.sh:257 src/lib/menu.sh
msgid "Lock screens"
msgstr "Écrans de verrouillage"

#: src/lib/menu.sh:259 src/lib/menu.sh
msgid "Photo check"
msgstr "Contrôle anti-photo"

#: src/lib/menu.sh:262
msgid "Paused"
msgstr "En pause"

#: src/lib/menu.sh:262
#, sh-printf-format
msgid "for %d more minutes, or until the password is used"
msgstr "encore %d minutes, ou jusqu'à l'utilisation du mot de passe"

#: src/lib/menu.sh:264
msgid "Last unlock"
msgstr "Dernier déverrouillage"

#: src/lib/menu.sh:270
msgid "The lock screen agent is not running."
msgstr "L'agent de l'écran de verrouillage ne tourne pas."

#: src/lib/menu.sh:322
msgid ""
"On GNOME a small GNOME extension shows the bubble. Turning face unlock on "
"switches it on."
msgstr ""
"Sous GNOME, une petite extension GNOME affiche la bulle. Activer le "
"déverrouillage facial l'active aussi."

#: src/lib/menu.sh:326
msgid ""
"Scans when you come back to hyprlock, swaylock or face-unlock's own lock "
"screen (`face-unlock lock`, with the bubble), and opens them. Other lock "
"screens scan on Enter."
msgstr ""
"Scanne quand vous revenez à hyprlock, swaylock ou à l'écran de verrouillage "
"de face-unlock (`face-unlock lock`, avec la bulle) et les ouvre. Les autres "
"écrans de verrouillage scannent avec Entrée."

#: src/lib/menu.sh:331
msgid ""
"Unlocks the lock screen when it sees your face. Off: only your password "
"works there."
msgstr ""
"Déverrouille l'écran de verrouillage quand il voit votre visage. Désactivé : "
"seul votre mot de passe fonctionne."

#: src/lib/menu.sh:332
msgid ""
"Scans when you press a key or move the mouse on the lock screen, and when "
"the computer wakes up."
msgstr ""
"Scanne quand vous appuyez sur une touche ou bougez la souris sur l'écran de "
"verrouillage, et au réveil de l'ordinateur."

#: src/lib/menu.sh:333
msgid ""
"Scans as soon as the screen locks. Off by default: if you lock it yourself, "
"it would unlock again right away."
msgstr ""
"Scanne dès que l'écran se verrouille. Désactivé par défaut : si vous "
"verrouillez vous-même, il se déverrouillerait aussitôt."

#: src/lib/menu.sh:334
msgid ""
"sudo takes your face instead of the password. No match: you type the "
"password as usual."
msgstr ""
"sudo prend votre visage au lieu du mot de passe. Sinon, vous tapez le mot de "
"passe comme d'habitude."

#: src/lib/menu.sh:335
msgid ""
"face-unlock's lock screen shows the bubble, and you lock with `face-unlock "
"lock`. Or keep yours: hyprlock then shows a line of text at the top. Enter "
"opens the choice."
msgstr ""
"L'écran de verrouillage de face-unlock affiche la bulle, et vous verrouillez "
"avec `face-unlock lock`. Ou gardez le vôtre : hyprlock affiche alors une "
"ligne de texte en haut. Entrée ouvre le choix."

#: src/lib/menu.sh:336
msgid ""
"The picture behind face-unlock's own lock screen (`face-unlock lock`). "
"Empty: the one on your desktop. Or a file, a folder to take one from at "
"random, or `none`. Enter to type it."
msgstr ""
"L'image derrière l'écran de verrouillage de face-unlock (`face-unlock "
"lock`). Vide : celle de votre bureau. Ou un fichier, un dossier où en "
"prendre une au hasard, ou `none`. Entrée pour la saisir."

#: src/lib/menu.sh:337
msgid "Blurs the picture behind face-unlock's own lock screen."
msgstr "Floute l'image derrière l'écran de verrouillage de face-unlock."

#: src/lib/menu.sh:338
#, sh-printf-format
msgid ""
"The lock screen takes your face in its password check. Press Enter on the "
"empty field to scan. Found here: %s."
msgstr ""
"L'écran de verrouillage accepte votre visage dans sa vérification du mot de "
"passe. Appuyez sur Entrée dans le champ vide pour scanner. Trouvés ici : %s."

#: src/lib/menu.sh:339
msgid ""
"The password windows of your desktop and apps, for example when you install "
"software. No match: you type the password."
msgstr ""
"Les fenêtres de mot de passe de votre bureau et des applications, par "
"exemple pour installer un logiciel. Sinon, vous tapez le mot de passe."

#: src/lib/menu.sh:340
msgid ""
"You have to blink or turn your head a little. This also stops printed photos."
msgstr ""
"Vous devez cligner des yeux ou tourner un peu la tête. Cela bloque aussi les "
"photos imprimées."

#: src/lib/menu.sh:341
msgid "No check at all. Only for trying out a camera."
msgstr "Aucun contrôle. Seulement pour essayer une caméra."

#: src/lib/menu.sh:342
msgid ""
"Stops photos on a phone, a tablet or glossy paper. You do not have to blink. "
"A matte printed photo can get through."
msgstr ""
"Bloque les photos sur un téléphone, une tablette ou du papier brillant. Pas "
"besoin de cligner des yeux. Une photo imprimée mate peut passer."

#: src/lib/menu.sh:343
msgid ""
"Fewer wrong matches, but it may not know you with glasses or in bad light."
msgstr ""
"Moins d'erreurs de correspondance, mais il peut ne pas vous reconnaître avec "
"des lunettes ou sous une mauvaise lumière."

#: src/lib/menu.sh:344
msgid "Knows you more easily, but also somebody who looks a lot like you."
msgstr ""
"Vous reconnaît plus facilement, mais aussi quelqu'un qui vous ressemble "
"beaucoup."

#: src/lib/menu.sh:345
msgid "The default. Right for most people."
msgstr "La valeur par défaut. Convient à la plupart des gens."

#: src/lib/menu.sh:346
msgid ""
"Your eyes have to be open and on the screen. So it does not unlock while you "
"look away or sleep."
msgstr ""
"Vos yeux doivent être ouverts et tournés vers l'écran. Ainsi, rien ne se "
"déverrouille quand vous regardez ailleurs ou dormez."

#: src/lib/menu.sh:347
msgid ""
"Automatic takes the first normal camera. After a change, set up your face "
"again. An infrared camera needs its light on (linux-enable-ir-emitter)."
msgstr ""
"Automatique prend la première caméra normale. Après un changement, "
"reconfigurez votre visage. Une caméra infrarouge doit avoir sa lumière "
"allumée (linux-enable-ir-emitter)."

#: src/lib/menu.sh:348
msgid "How long the camera looks for your face before it gives up."
msgstr "Combien de temps la caméra cherche votre visage avant d'abandonner."

#: src/lib/menu.sh:349
msgid ""
"After a sure match it keeps how you look now. So a new haircut or glasses "
"need no new setup."
msgstr ""
"Après une correspondance sûre, il retient votre apparence actuelle. Une "
"nouvelle coupe ou des lunettes ne demandent donc pas de nouvelle "
"configuration."

#: src/lib/menu.sh:350
msgid ""
"No scan while the laptop is closed, for example at a desk with an external "
"screen."
msgstr ""
"Pas de scan quand le portable est fermé, par exemple à un bureau avec un "
"écran externe."

#: src/lib/menu.sh:351
msgid "The bubble at the top of the screen shows what the camera is doing."
msgstr "La bulle en haut de l'écran montre ce que fait la caméra."

#: src/lib/menu.sh:352
msgid "A small pill with a lock that opens."
msgstr "Une petite pilule avec un cadenas qui s'ouvre."

#: src/lib/menu.sh:353
msgid "An island with a face that looks around, then rings and a tick."
msgstr ""
"Un îlot avec un visage qui regarde autour de lui, puis des anneaux et une "
"coche."

#: src/lib/menu.sh:354
msgid "How fast the bubble moves."
msgstr "La vitesse à laquelle la bulle bouge."

#: src/lib/menu.sh:355
msgid "Shows the bubble when sudo or an admin prompt scans your face, too."
msgstr ""
"Affiche aussi la bulle quand sudo ou une demande d'administration scanne "
"votre visage."

#: src/lib/menu.sh:448
#, sh-printf-format
msgid "automatic (%s)"
msgstr "automatique (%s)"

#: src/lib/menu.sh:458
msgid "(infrared)"
msgstr "(infrarouge)"

#: src/lib/menu.sh:462
msgid "(not connected)"
msgstr "(non branchée)"

#: src/lib/menu.sh:471
msgid "same as desktop"
msgstr "comme le bureau"

#: src/lib/menu.sh:475
msgid "none"
msgstr "aucun"

#: src/lib/menu.sh:504
msgid "Picture or folder:"
msgstr "Image ou dossier :"

#: src/lib/menu.sh:509
#, sh-printf-format
msgid "Not found: %s"
msgstr "Introuvable : %s"

#: src/lib/menu.sh:580 src/lib/menu.sh:771
msgid "Settings"
msgstr "Réglages"

#: src/lib/menu.sh:581
msgid "↑↓ select   ←→ or Space: change   q: back"
msgstr "↑↓ choisir   ←→ ou Espace : changer   q : retour"

#: src/lib/menu.sh:582
msgid "for all users, asks for your password"
msgstr "pour tous, demande votre mot de passe"

#. TRANSLATORS: keep the letters, they are the keys.
#: src/lib/menu.sh:683
msgid "Up/Down: select, Space: on/off, r: rename, d: delete, a: add, q: back"
msgstr ""
"Haut/Bas : choisir, Espace : activer/désactiver, r : renommer, d : "
"supprimer, a : ajouter, q : retour"

#: src/lib/menu.sh:684
msgid "No face is set up yet. Press a to add one."
msgstr "Aucun visage n'est encore configuré. Appuyez sur a pour en ajouter un."

#: src/lib/menu.sh:730
msgid "New name:"
msgstr "Nouveau nom :"

#: src/lib/menu.sh:737
#, sh-printf-format
msgid "Delete \"%s\"?"
msgstr "Supprimer « %s » ?"

#: src/lib/menu.sh:768
msgid "Turn face unlock on or off"
msgstr "Activer ou désactiver le déverrouillage facial"

#: src/lib/menu.sh:772
msgid "Try it"
msgstr "Essayer"

#: src/lib/menu.sh:773
msgid "Quit"
msgstr "Quitter"

#: src/lib/migrate.sh:119
msgid ""
"Moving your faces and settings over from plasma-face-unlock. That needs your "
"password."
msgstr ""
"Reprise de vos visages et réglages depuis plasma-face-unlock. Cela demande "
"votre mot de passe."

#: src/lib/pam.sh:191
