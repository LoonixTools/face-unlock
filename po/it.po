msgid "Not a service this can be used for: %s"
msgstr "Non si può usare per questo servizio: %s"

#: src/lib/system.sh:146 src/lib/system.sh:151
#, sh-printf-format
msgid ""
"Hyprland does not start the lock screen agent by itself. Add this to %s:"
msgstr ""
"Hyprland non avvia da solo l'agente della schermata di blocco. Aggiungi "
"questo a %s:"

#: src/lib/system.sh:267 src/lib/system.sh:270
#, sh-printf-format
msgid "To lock with it, add this to %s, and set %s in %s:"
msgstr "Per bloccare con essa, aggiungi questo a %s e imposta %s in %s:"

#: src/lib/system.sh:275
#, sh-printf-format
msgid "To lock with it, add this to the binds in %s, and use %s in swayidle:"
msgstr ""
"Per bloccare con essa, aggiungi questo ai binds in %s e usa %s in swayidle:"

#: src/lib/system.sh:279
#, sh-printf-format
msgid "To lock with it, run %s where your lock screen is started now."
msgstr ""
"Per bloccare con essa, esegui %s dove ora parte la tua schermata di blocco."

#: src/lib/system.sh:292
msgid "You lock with face-unlock's lock screen now."
msgstr "Ora blocchi con la schermata di blocco di face-unlock."

#: src/lib/system.sh:299
msgid ""
"hyprlock shows what face unlock is doing at the top, from the next time it "
"locks."
msgstr ""
"hyprlock mostra in alto cosa sta facendo face unlock, dal prossimo blocco."

#: src/lib/system.sh:300
#, sh-printf-format
msgid "Could not add the line to %s."
msgstr "Impossibile aggiungere la riga a %s."

#: src/lib/system.sh:301
msgid ""
"Your lock screen stays as it is. Press Enter on the empty password field to "
"scan."
msgstr ""
"La tua schermata di blocco resta com'è. Premi Invio nel campo password vuoto "
"per la scansione."

#: src/lib/system.sh:302
#, sh-printf-format
msgid "hyprlock has no %s, so it cannot show the text."
msgstr "hyprlock non ha %s, quindi non può mostrare il testo."

