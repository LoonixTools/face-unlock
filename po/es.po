#: src/face-unlock:50
msgid ""
"Face unlock's service has to be switched on once for this computer. That "
"needs your password."
msgstr ""
"El servicio de desbloqueo facial tiene que activarse una vez en este equipo. "
"Para ello hace falta tu contraseña."

#: src/face-unlock:57
#, sh-printf-format
msgid "Check it with: systemctl status %s"
msgstr "Compruébalo con: systemctl status %s"

#: src/face-unlock:67
msgid ""
"Setting up a face needs the camera picture on screen. Run this inside your "
"desktop session."
msgstr ""
"Para configurar una cara, la imagen de la cámara tiene que verse en "
"pantalla. Ejecuta esto dentro de tu sesión de escritorio."

#: src/face-unlock:71
msgid "The setup window is open. Follow it there."
msgstr "La ventana de configuración está abierta. Sigue los pasos allí."

#: src/face-unlock:80
msgid "The face is set up."
msgstr "La cara está configurada."

#: src/face-unlock:83
#, sh-printf-format
msgid "Face unlock is still off. Turn it on with [1] or `%s enable`."
msgstr ""
"El desbloqueo facial sigue desactivado. Actívalo con [1] o `%s enable`."

#: src/face-unlock:87
msgid "No face was added."
msgstr "No se añadió ninguna cara."

#: src/face-unlock:96
msgid "First, set up your face."
msgstr "Primero, configura tu cara."

#: src/face-unlock:100 src/face-unlock:145 src/lib/menu.sh:517
#: src/lib/menu.sh:521 src/lib/menu.sh:527 src/lib/menu.sh:529
#: src/lib/system.sh:290 src/lib/system.sh:296
msgid "Could not save the setting."
msgstr "No se pudo guardar el ajuste."

#: src/face-unlock:104
msgid "Could not start the lock screen agent."
msgstr "No se pudo iniciar el agente de la pantalla de bloqueo."

#: src/face-unlock:107
msgid "No systemd user session, so the lock screen agent was not started."
msgstr ""
"No hay sesión de usuario de systemd, así que no se inició el agente de la "
"pantalla de bloqueo."

#: src/face-unlock:123
msgid "Could not switch on the GNOME extension that shows the bubble."
msgstr "No se pudo activar la extensión de GNOME que muestra la burbuja."

#: src/face-unlock:124
msgid "Log out and back in once: then GNOME shows the bubble too."
msgstr ""
"Cierra la sesión y vuelve a entrar una vez: entonces GNOME también muestra "
"la burbuja."

#: src/face-unlock:131
msgid "Pick your lock screen in the window."
msgstr "Elige tu pantalla de bloqueo en la ventana."

#: src/face-unlock:132
msgid "No lock screen picked. You can do it later under Settings."
msgstr ""
"No se eligió ninguna pantalla de bloqueo. Puedes hacerlo luego en Ajustes."

#: src/face-unlock:135
#, sh-printf-format
msgid ""
"The lock screen (%s) takes your face too. If it does not scan when you come "
"back, press Enter on the empty password field."
msgstr ""
"La pantalla de bloqueo (%s) también acepta tu cara. Si no escanea cuando "
"vuelves, pulsa Intro en el campo de contraseña vacío."

#: src/face-unlock:138
msgid "Face unlock is on. Lock the screen and look at it to try."
msgstr ""
"El desbloqueo facial está activado. Bloquea la pantalla y mírala para "
"probarlo."

#: src/face-unlock:140
msgid "It can do sudo and admin prompts too. See Settings."
msgstr ""
"También funciona con sudo y las solicitudes de administrador. Consulta "
"Ajustes."

#: src/face-unlock:156
msgid "Face unlock is off. Your faces are kept; delete them under Faces."
msgstr ""
"El desbloqueo facial está desactivado. Tus caras se conservan; bórralas en "
"Caras."

#: src/face-unlock:170 src/lib/daemon.sh:109
msgid "No face is set up yet."
msgstr "Todavía no hay ninguna cara configurada."

#: src/face-unlock:174 src/lib/menu.sh:180 src/lib/menu.sh:685
msgid "on"
msgstr "activado"

#: src/face-unlock:174 src/lib/menu.sh:182 src/lib/menu.sh:192
#: src/lib/menu.sh:686
msgid "off"
msgstr "desactivado"

#: src/face-unlock:176 src/lib/menu.sh:703
#, sh-printf-format
msgid "%s samples, %s learned"
msgstr "%s muestras, %s aprendidas"

#: src/face-unlock:182
#, sh-printf-format
msgid "Which face? See `%s faces` for the ids."
msgstr "¿Qué cara? Consulta `%s faces` para ver los ID."

#: src/face-unlock:186
msgid "Deleted."
msgstr "Borrado."

#: src/face-unlock:197
msgid "Usage: face-unlock [command]"
msgstr "Uso: face-unlock [comando]"

#: src/face-unlock:199
msgid "Commands:"
msgstr "Comandos:"

#: src/face-unlock:200
msgid "Turn face unlock on"
msgstr "Activar el desbloqueo facial"

#: src/face-unlock:201
msgid "Turn it off (faces are kept)"
msgstr "Desactivarlo (las caras se conservan)"

#: src/face-unlock:202 src/lib/menu.sh:769
msgid "Add a face"
msgstr "Añadir una cara"

#: src/face-unlock:203
msgid "List the faces"
msgstr "Listar las caras"

#: src/face-unlock:204
msgid "Delete a face"
msgstr "Borrar una cara"

#: src/face-unlock:205
msgid "Look at the camera and see what it sees"
msgstr "Mirar a la cámara y ver lo que ve"

#: src/face-unlock:206
msgid "Lock the screen"
msgstr "Bloquear la pantalla"

#: src/face-unlock:207
msgid "Show what is on"
msgstr "Mostrar qué está activado"

#: src/face-unlock:208
msgid "Show this help"
msgstr "Mostrar esta ayuda"

#: src/face-unlock:209
msgid "Show the version"
msgstr "Mostrar la versión"

#: src/face-unlock:211
msgid "Without a command an interactive menu is shown."
msgstr "Sin comando se muestra un menú interactivo."

#: src/face-unlock:230
msgid ""
"Run this as your own user, not as root. It asks for your password when it "
"needs to."
msgstr ""
"Ejecuta esto con tu propio usuario, no como root. Pide tu contraseña cuando "
"la necesita."

#: src/face-unlock:253 src/lib/system.sh:101
#, sh-printf-format
msgid "Unknown command: %s"
msgstr "Comando desconocido: %s"

#: src/lib/common.sh:173
msgid "never"
msgstr "nunca"

#: src/lib/common.sh:183
msgid "just now"
msgstr "ahora mismo"

#: src/lib/common.sh:185
msgid "1 minute ago"
msgstr "hace 1 minuto"

#: src/lib/common.sh:188
#, sh-printf-format
msgid "%d minutes ago"
msgstr "hace %d minutos"

#: src/lib/common.sh:190
msgid "1 hour ago"
msgstr "hace 1 hora"

#: src/lib/common.sh:193
#, sh-printf-format
msgid "%d hours ago"
msgstr "hace %d horas"

#: src/lib/common.sh:195
msgid "1 day ago"
msgstr "hace 1 día"

#: src/lib/common.sh:198
#, sh-printf-format
msgid "%d days ago"
msgstr "hace %d días"

#: src/lib/daemon.sh:102
msgid "The face did not match."
msgstr "La cara no coincidió."

#: src/lib/daemon.sh:103
msgid "That looked like a photo or a screen."
msgstr "Parecía una foto o una pantalla."

#: src/lib/daemon.sh:104
msgid "The face matched, but did not blink or move."
msgstr "La cara coincidió, pero no parpadeó ni se movió."

#: src/lib/daemon.sh:105
msgid "The face was not looking at the screen."
msgstr "La cara no miraba a la pantalla."

#: src/lib/daemon.sh:106
msgid "The picture was too dark, too blurry or too far away."
msgstr "La imagen estaba demasiado oscura, borrosa o lejos."

#: src/lib/daemon.sh:107
msgid "No face in view."
msgstr "No hay ninguna cara a la vista."

#: src/lib/daemon.sh:108
msgid ""
"Face unlock is paused after too many tries. Unlock once with your password."
msgstr ""
"El desbloqueo facial está en pausa tras demasiados intentos. Desbloquea una "
"vez con tu contraseña."

#: src/lib/daemon.sh:110
msgid "The camera could not be used."
msgstr "No se pudo usar la cámara."

#: src/lib/daemon.sh:111 src/lib/menu.sh:267
msgid "The recognition models are missing. Reinstall the package."
msgstr "Faltan los modelos de reconocimiento. Reinstala el paquete."

#: src/lib/daemon.sh:112
msgid "The lid is closed."
msgstr "La tapa está cerrada."

#: src/lib/daemon.sh:113
msgid "The camera is busy with another scan."
msgstr "La cámara está ocupada con otro escaneo."

#: src/lib/daemon.sh:114
msgid "The face unlock service is not running."
msgstr "El servicio de desbloqueo facial no está en marcha."

#: src/lib/daemon.sh:115
msgid "Not allowed."
msgstr "No permitido."

#: src/lib/daemon.sh:116
#, sh-printf-format
msgid "Something went wrong (%s)."
msgstr "Algo salió mal (%s)."

#: src/lib/daemon.sh:127
msgid "Look at the camera. Blink once, or turn your head a little."
msgstr "Mira a la cámara. Parpadea una vez o gira un poco la cabeza."

#: src/lib/daemon.sh:137
msgid "Face found."
msgstr "Cara encontrada."

#: src/lib/daemon.sh:141
msgid "Recognised. Now blink once, or turn your head a little."
msgstr "Reconocida. Ahora parpadea una vez o gira un poco la cabeza."

#: src/lib/daemon.sh:142
msgid "Look at the screen."
msgstr "Mira a la pantalla."

#: src/lib/daemon.sh:143
msgid "Move closer to the camera."
msgstr "Acércate a la cámara."

#: src/lib/daemon.sh:144
msgid "It is too dark to see your face."
msgstr "Está demasiado oscuro para ver tu cara."

#: src/lib/daemon.sh:153
msgid "match"
msgstr "similitud"

#: src/lib/daemon.sh:153
msgid "turn"
msgstr "giro"

#: src/lib/daemon.sh:154
msgid "eyes"
msgstr "ojos"

#: src/lib/daemon.sh:155
msgid "depth"
msgstr "profundidad"

#: src/lib/daemon.sh:155 src/lib/daemon.sh:164
msgid "blink"
msgstr "parpadeo"

#: src/lib/daemon.sh:156
msgid "glare"
msgstr "reflejo"

#: src/lib/daemon.sh:156
msgid "edge"
msgstr "borde"

#: src/lib/daemon.sh:165
msgid "head turn"
msgstr "giro de cabeza"

#: src/lib/daemon.sh:167
#, sh-printf-format
msgid "Recognised as %s (match %s) in %s ms."
msgstr "Reconocido como %s (similitud %s) en %s ms."

#: src/lib/daemon.sh:168
#, sh-printf-format
msgid "Sign of life: %s"
msgstr "Señal de vida: %s"

#: src/lib/daemon.sh:173
msgid ""
"That was too many tries. Face unlock is paused until you unlock with your "
"password."
msgstr ""
"Demasiados intentos. El desbloqueo facial está en pausa hasta que "
"desbloquees con tu contraseña."

#. TRANSLATORS: the letter after "[" is the key for yes. y works too.
#: src/lib/menu.sh:141
msgid "[y/N]"
msgstr "[s/N]"

#: src/lib/menu.sh:172 src/lib/menu.sh:583
msgid "ON"
msgstr "ACTIVADO"

#: src/lib/menu.sh:174 src/lib/menu.sh:584
msgid "OFF"
msgstr "DESACTIVADO"

#: src/lib/menu.sh:190 src/lib/menu.sh:194
msgid "strict"
msgstr "estricto"

#: src/lib/menu.sh:191
msgid "basic"
msgstr "básico"

#: src/lib/menu.sh:193 src/lib/menu.sh:198
msgid "normal"
msgstr "normal"

#: src/lib/menu.sh:195
msgid "relaxed"
msgstr "flexible"

#: src/lib/menu.sh:196
msgid "island with the face"
msgstr "isla con la cara"

#: src/lib/menu.sh:197
msgid "small pill with a lock"
msgstr "pastilla con candado"

#: src/lib/menu.sh:199
msgid "fast"
msgstr "rápida"

#: src/lib/menu.sh:200
msgid "slow"
msgstr "lenta"

#: src/lib/menu.sh:201
#, sh-printf-format
msgid "%s seconds"
msgstr "%s segundos"

#: src/lib/menu.sh:202 src/lib/menu.sh:452
msgid "automatic"
msgstr "automática"

#: src/lib/menu.sh:203
