#: src/face-unlock:50
msgid ""
"Face unlock's service has to be switched on once for this computer. That "
"needs your password."
msgstr ""
"De dienst voor gezichtsontgrendeling moet één keer op deze computer worden "
"ingeschakeld. Daarvoor is je wachtwoord nodig."

#: src/face-unlock:57
#, sh-printf-format
msgid "Check it with: systemctl status %s"
msgstr "Controleer met: systemctl status %s"

#: src/face-unlock:67
msgid ""
"Setting up a face needs the camera picture on screen. Run this inside your "
"desktop session."
msgstr ""
"Voor het instellen van een gezicht moet het camerabeeld op het scherm staan. "
"Voer dit uit in je bureaubladsessie."

#: src/face-unlock:71
msgid "The setup window is open. Follow it there."
msgstr "Het instelvenster is open. Volg daar de stappen."

#: src/face-unlock:80
msgid "The face is set up."
msgstr "Het gezicht is ingesteld."

#: src/face-unlock:83
#, sh-printf-format
msgid "Face unlock is still off. Turn it on with [1] or `%s enable`."
msgstr ""
"Gezichtsontgrendeling staat nog uit. Zet het aan met [1] of `%s enable`."

#: src/face-unlock:87
msgid "No face was added."
msgstr "Er is geen gezicht toegevoegd."

#: src/face-unlock:96
msgid "First, set up your face."
msgstr "Stel eerst je gezicht in."

#: src/face-unlock:100 src/face-unlock:145 src/lib/menu.sh:517
#: src/lib/menu.sh:521 src/lib/menu.sh:527 src/lib/menu.sh:529
#: src/lib/system.sh:290 src/lib/system.sh:296
msgid "Could not save the setting."
msgstr "Kon de instelling niet opslaan."

#: src/face-unlock:104
msgid "Could not start the lock screen agent."
msgstr "Kon de agent voor het vergrendelscherm niet starten."

#: src/face-unlock:107
msgid "No systemd user session, so the lock screen agent was not started."
msgstr ""
"Geen systemd-gebruikerssessie, dus de agent voor het vergrendelscherm is "
"niet gestart."

#: src/face-unlock:123
msgid "Could not switch on the GNOME extension that shows the bubble."
msgstr "Kon de GNOME-extensie die de bubbel toont niet inschakelen."

#: src/face-unlock:124
msgid "Log out and back in once: then GNOME shows the bubble too."
msgstr "Meld je één keer af en weer aan: dan toont GNOME de bubbel ook."

#: src/face-unlock:131
msgid "Pick your lock screen in the window."
msgstr "Kies je vergrendelscherm in het venster."

#: src/face-unlock:132
msgid "No lock screen picked. You can do it later under Settings."
msgstr "Geen vergrendelscherm gekozen. Dat kan later ook onder Instellingen."

#: src/face-unlock:135
#, sh-printf-format
msgid ""
"The lock screen (%s) takes your face too. If it does not scan when you come "
"back, press Enter on the empty password field."
msgstr ""
"Het vergrendelscherm (%s) neemt je gezicht ook. Scant het niet als je "
"terugkomt, druk dan op Enter in het lege wachtwoordveld."

#: src/face-unlock:138
msgid "Face unlock is on. Lock the screen and look at it to try."
msgstr ""
"Gezichtsontgrendeling staat aan. Vergrendel het scherm en kijk ernaar om het "
"te proberen."

#: src/face-unlock:140
msgid "It can do sudo and admin prompts too. See Settings."
msgstr "Het werkt ook voor sudo en beheerdersvragen. Zie Instellingen."

#: src/face-unlock:156
msgid "Face unlock is off. Your faces are kept; delete them under Faces."
msgstr ""
"Gezichtsontgrendeling staat uit. Je gezichten blijven bewaard; verwijder ze "
"onder Gezichten."

#: src/face-unlock:170 src/lib/daemon.sh:109
msgid "No face is set up yet."
msgstr "Er is nog geen gezicht ingesteld."

#: src/face-unlock:174 src/lib/menu.sh:180 src/lib/menu.sh:685
msgid "on"
msgstr "aan"

#: src/face-unlock:174 src/lib/menu.sh:182 src/lib/menu.sh:192
#: src/lib/menu.sh:686
msgid "off"
msgstr "uit"

#: src/face-unlock:176 src/lib/menu.sh:703
#, sh-printf-format
msgid "%s samples, %s learned"
msgstr "%s opnames, %s bijgeleerd"

#: src/face-unlock:182
#, sh-printf-format
msgid "Which face? See `%s faces` for the ids."
msgstr "Welk gezicht? Zie `%s faces` voor de ID's."

#: src/face-unlock:186
msgid "Deleted."
msgstr "Verwijderd."

#: src/face-unlock:197
msgid "Usage: face-unlock [command]"
msgstr "Gebruik: face-unlock [opdracht]"

#: src/face-unlock:199
msgid "Commands:"
msgstr "Opdrachten:"

#: src/face-unlock:200
msgid "Turn face unlock on"
msgstr "Gezichtsontgrendeling aanzetten"

#: src/face-unlock:201
msgid "Turn it off (faces are kept)"
msgstr "Uitzetten (gezichten blijven bewaard)"

#: src/face-unlock:202 src/lib/menu.sh:769
msgid "Add a face"
msgstr "Een gezicht toevoegen"

#: src/face-unlock:203
msgid "List the faces"
msgstr "De gezichten tonen"

#: src/face-unlock:204
msgid "Delete a face"
msgstr "Een gezicht verwijderen"

#: src/face-unlock:205
msgid "Look at the camera and see what it sees"
msgstr "In de camera kijken en zien wat hij ziet"

#: src/face-unlock:206
msgid "Lock the screen"
msgstr "Scherm vergrendelen"

#: src/face-unlock:207
msgid "Show what is on"
msgstr "Tonen wat er aan staat"

#: src/face-unlock:208
msgid "Show this help"
msgstr "Deze hulp tonen"

#: src/face-unlock:209
msgid "Show the version"
msgstr "De versie tonen"

#: src/face-unlock:211
msgid "Without a command an interactive menu is shown."
msgstr "Zonder opdracht verschijnt een interactief menu."

#: src/face-unlock:230
msgid ""
"Run this as your own user, not as root. It asks for your password when it "
"needs to."
msgstr ""
"Voer dit uit als je eigen gebruiker, niet als root. Het vraagt om je "
"wachtwoord als dat nodig is."

#: src/face-unlock:253 src/lib/system.sh:101
#, sh-printf-format
msgid "Unknown command: %s"
msgstr "Onbekende opdracht: %s"

#: src/lib/common.sh:173
msgid "never"
msgstr "nooit"

#: src/lib/common.sh:183
msgid "just now"
msgstr "zojuist"

#: src/lib/common.sh:185
msgid "1 minute ago"
msgstr "1 minuut geleden"

#: src/lib/common.sh:188
#, sh-printf-format
msgid "%d minutes ago"
msgstr "%d minuten geleden"

#: src/lib/common.sh:190
msgid "1 hour ago"
msgstr "1 uur geleden"

#: src/lib/common.sh:193
#, sh-printf-format
msgid "%d hours ago"
msgstr "%d uur geleden"

#: src/lib/common.sh:195
msgid "1 day ago"
msgstr "1 dag geleden"

#: src/lib/common.sh:198
#, sh-printf-format
msgid "%d days ago"
msgstr "%d dagen geleden"

#: src/lib/daemon.sh:102
msgid "The face did not match."
msgstr "Het gezicht kwam niet overeen."

#: src/lib/daemon.sh:103
msgid "That looked like a photo or a screen."
msgstr "Dat leek op een foto of een scherm."

#: src/lib/daemon.sh:104
msgid "The face matched, but did not blink or move."
msgstr "Het gezicht kwam overeen, maar knipperde niet en bewoog niet."

#: src/lib/daemon.sh:105
msgid "The face was not looking at the screen."
msgstr "Het gezicht keek niet naar het scherm."

#: src/lib/daemon.sh:106
msgid "The picture was too dark, too blurry or too far away."
msgstr "Het beeld was te donker, te wazig of te ver weg."

#: src/lib/daemon.sh:107
msgid "No face in view."
msgstr "Geen gezicht in beeld."

#: src/lib/daemon.sh:108
msgid ""
"Face unlock is paused after too many tries. Unlock once with your password."
msgstr ""
"Gezichtsontgrendeling is gepauzeerd na te veel pogingen. Ontgrendel één keer "
"met je wachtwoord."

#: src/lib/daemon.sh:110
msgid "The camera could not be used."
msgstr "De camera kon niet worden gebruikt."

#: src/lib/daemon.sh:111 src/lib/menu.sh:267
msgid "The recognition models are missing. Reinstall the package."
msgstr "De herkenningsmodellen ontbreken. Installeer het pakket opnieuw."

#: src/lib/daemon.sh:112
msgid "The lid is closed."
msgstr "Het deksel is dicht."

#: src/lib/daemon.sh:113
msgid "The camera is busy with another scan."
msgstr "De camera is bezig met een andere scan."

#: src/lib/daemon.sh:114
msgid "The face unlock service is not running."
msgstr "De dienst voor gezichtsontgrendeling draait niet."

#: src/lib/daemon.sh:115
msgid "Not allowed."
msgstr "Niet toegestaan."

#: src/lib/daemon.sh:116
#, sh-printf-format
msgid "Something went wrong (%s)."
msgstr "Er ging iets mis (%s)."

#: src/lib/daemon.sh:127
msgid "Look at the camera. Blink once, or turn your head a little."
msgstr "Kijk in de camera. Knipper één keer of draai je hoofd een beetje."

#: src/lib/daemon.sh:137
msgid "Face found."
msgstr "Gezicht gevonden."

#: src/lib/daemon.sh:141
msgid "Recognised. Now blink once, or turn your head a little."
msgstr "Herkend. Knipper nu één keer of draai je hoofd een beetje."

#: src/lib/daemon.sh:142
msgid "Look at the screen."
msgstr "Kijk naar het scherm."

#: src/lib/daemon.sh:143
msgid "Move closer to the camera."
msgstr "Kom dichter bij de camera."

#: src/lib/daemon.sh:144
msgid "It is too dark to see your face."
msgstr "Het is te donker om je gezicht te zien."

#: src/lib/daemon.sh:153
msgid "match"
msgstr "match"

#: src/lib/daemon.sh:153
msgid "turn"
msgstr "draai"

#: src/lib/daemon.sh:154
msgid "eyes"
msgstr "ogen"

#: src/lib/daemon.sh:155
msgid "depth"
msgstr "diepte"

#: src/lib/daemon.sh:155 src/lib/daemon.sh:164
msgid "blink"
msgstr "knipperen"

#: src/lib/daemon.sh:156
msgid "glare"
msgstr "schittering"

#: src/lib/daemon.sh:156
msgid "edge"
msgstr "rand"

#: src/lib/daemon.sh:165
msgid "head turn"
msgstr "hoofddraai"

#: src/lib/daemon.sh:167
#, sh-printf-format
msgid "Recognised as %s (match %s) in %s ms."
msgstr "Herkend als %s (match %s) in %s ms."

#: src/lib/daemon.sh:168
#, sh-printf-format
msgid "Sign of life: %s"
msgstr "Teken van leven: %s"

#: src/lib/daemon.sh:173
msgid ""
"That was too many tries. Face unlock is paused until you unlock with your "
"password."
msgstr ""
"Dat waren te veel pogingen. Gezichtsontgrendeling is gepauzeerd tot je met "
"je wachtwoord ontgrendelt."

