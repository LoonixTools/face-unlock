#: src/lib/menu.sh:190 src/lib/menu.sh:194
msgid "strict"
msgstr "streng"

#: src/lib/menu.sh:191
msgid "basic"
msgstr "basis"

#: src/lib/menu.sh:193 src/lib/menu.sh:198
msgid "normal"
msgstr "normaal"

#: src/lib/menu.sh:195
msgid "relaxed"
msgstr "soepel"

#: src/lib/menu.sh:196
msgid "island with the face"
msgstr "eiland met gezicht"

#: src/lib/menu.sh:197
msgid "small pill with a lock"
msgstr "kleine pil met slot"

#: src/lib/menu.sh:199
msgid "fast"
msgstr "snel"

#: src/lib/menu.sh:200
msgid "slow"
msgstr "langzaam"

#: src/lib/menu.sh:201
#, sh-printf-format
