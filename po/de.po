msgid "Unlock with your face"
msgstr "Mit dem Gesicht entsperren"

#: src/lib/menu.sh
msgid "Scan when you come back"
msgstr "Scannen, wenn du zurückkommst"

#: src/lib/menu.sh
msgid "Scan right after locking"
msgstr "Gleich nach dem Sperren scannen"

