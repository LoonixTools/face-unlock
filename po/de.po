#, sh-printf-format
msgid "automatic (%s)"
msgstr "automatisch (%s)"

#: src/lib/menu.sh:387
msgid "(infrared)"
msgstr "(Infrarot)"

#: src/lib/menu.sh:391
msgid "(not connected)"
msgstr "(nicht angeschlossen)"

