"hinzufügen, q: zurück"

#: src/lib/menu.sh:562
msgid "No face is set up yet. Press a to add one."
msgstr "Es ist noch kein Gesicht eingerichtet. Drück a, um eins hinzuzufügen."

#: src/lib/menu.sh:607
msgid "New name:"
msgstr "Neuer Name:"

#: src/lib/menu.sh:614
#, sh-printf-format
msgid "Delete \"%s\"?"
msgstr "„%s“ löschen?"

